# Copy to .env. Generate a private token (16+ characters); never expose provider keys to the browser.
DEMO_ACCESS_TOKEN=replace-with-a-random-private-token
DATABASE_URL=postgresql+psycopg://rivalpulse:rivalpulse@localhost:15432/rivalpulse
REDIS_URL=redis://localhost:6379/0
WORKSPACE_ID=private-demo
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Must be explicitly changed to replay for synthetic demonstrations. No automatic fallback.
MODE=live
REPLAY_SCENARIO=baseline
SECTORS_API_KEY=
CREDIT_TOTAL=1000
CREDIT_RESERVE=200
RUN_CREDIT_LIMIT=16
CACHE_SECONDS=86400
MAX_TOOL_CALLS=12
RUN_TIMEOUT=180
MAX_RUN_ATTEMPTS=3
PROVIDER_TIMEOUT=10

# Optional replaceable chat-completions compatible HTTPS adapter.
# Without it, conservative deterministic interpretations are explicitly labeled.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
