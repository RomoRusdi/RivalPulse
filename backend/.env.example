AUTH_MODE=accounts
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
# SMTP for account verification, independent of research alerts.
VERIFICATION_SMTP_HOST=
VERIFICATION_SMTP_PORT=587
VERIFICATION_SMTP_SECURITY=starttls
VERIFICATION_SMTP_USERNAME=
VERIFICATION_SMTP_PASSWORD=
VERIFICATION_EMAIL_FROM=
TAB_SESSION_REQUIRED=true
COOKIE_SECURE=false
AUTH_ORIGINS=["http://localhost:8080","http://localhost:3000","http://localhost:8000"]
CHAT_TIMEOUT=60
# Optional legacy demo token, used only with AUTH_MODE=demo.
# Keep provider keys and passwords server-side in this ignored file.
DEMO_ACCESS_TOKEN=replace-with-a-random-private-token
DATABASE_URL=postgresql+psycopg://rivalpulse:rivalpulse@localhost:15432/rivalpulse
REDIS_URL=redis://localhost:6379/0
WORKSPACE_ID=private-demo
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Live research uses Sectors v2 only. Replay is reserved for automated tests.
MODE=live
REPLAY_SCENARIO=baseline
SECTORS_API_KEY=
CREDIT_TOTAL=1000
WORKSPACE_CREDIT_TOTAL=1000
CREDIT_RESERVE=200
RUN_CREDIT_LIMIT=16
CACHE_SECONDS=86400
MAX_TOOL_CALLS=12
RUN_TIMEOUT=180
MAX_RUN_ATTEMPTS=3
PROVIDER_TIMEOUT=10

# Local AI is the default; owners can select a cloud provider in Settings.
# Keep tool planning deterministic unless bounded model planning is explicitly enabled.
# Unavailable AI wording does not discard successfully collected evidence.
LLM_ENABLED=true
LLM_PLAN_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT=240
# Shared classification + interpretation deadline; a portion is reserved for reasoning.
# Does not cap provider collection time or guarantee a complete investigation.
LLM_EVIDENCE_TIMEOUT=120
# Server-only Fernet master key for workspace Sectors/cloud credentials.
# Generate once with python scripts/init_llm_key.py (never prints/overwrites it).
# Store outside Git and retain the exact key with protected DB backups.
LLM_KEY_ENCRYPTION_KEY=
# Alternatively read the key from this private file; compose mounts it read-only.
LLM_KEY_ENCRYPTION_KEY_FILE=.env.llm-encryption
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096

# Optional Gmail digest for the preserved WORKSPACE_ID only. New account
# workspaces never send their research to this legacy recipient. Use a Gmail App
# Password, never an account password. One digest per run; baseline and
# unchanged findings are suppressed.
ALERTS_ENABLED=false
ALERT_MIN_SEVERITY=high
ALERT_EMAIL_TO=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
APP_BASE_URL=http://localhost:8080

# Legacy demo only (disabled in accounts mode): one bounded default-watchlist
# investigation per interval (never overlapping an active run, normal budgets).
# The email itself costs nothing extra; each sweep costs one normal run. The
# first interval only arms the timer, so enabling this never spends immediately.
SCHEDULED_SWEEP_ENABLED=false
SCHEDULED_SWEEP_INTERVAL_HOURS=24
