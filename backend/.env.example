# Copy to .env. Generate a private token (16+ characters); never expose provider keys to the browser.
DEMO_ACCESS_TOKEN=replace-with-a-random-private-token
DATABASE_URL=postgresql+psycopg://rivalpulse:rivalpulse@localhost:15432/rivalpulse
REDIS_URL=redis://localhost:6379/0
WORKSPACE_ID=private-demo
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Live research uses Sectors v2 only. Replay is reserved for automated tests.
MODE=live
REPLAY_SCENARIO=baseline
SECTORS_API_KEY=
CREDIT_TOTAL=1000
CREDIT_RESERVE=200
RUN_CREDIT_LIMIT=16
CACHE_SECONDS=86400
MAX_TOOL_CALLS=12
RUN_TIMEOUT=180
MAX_RUN_ATTEMPTS=3
PROVIDER_TIMEOUT=10

# Qwen is a mandatory core component: it plans the bounded tool pipeline,
# triages evidence, and writes claim-linked interpretations. Deterministic
# logic only validates/guards its output; a model outage fails the run
# instead of silently succeeding.
LLM_ENABLED=true
LLM_PLAN_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT=240
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096

# Optional Gmail digest for newly published important changes. Use a Gmail App
# Password, never an account password. One digest per run; baseline and
# unchanged findings are suppressed.
ALERTS_ENABLED=false
ALERT_MIN_SEVERITY=high
ALERT_EMAIL_TO=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
APP_BASE_URL=http://localhost:8080

# Optional scheduled sweep: the reconciler queues one bounded default-watchlist
# investigation per interval (never overlapping an active run, normal budgets).
# The email itself costs nothing extra; each sweep costs one normal run. The
# first interval only arms the timer, so enabling this never spends immediately.
SCHEDULED_SWEEP_ENABLED=false
SCHEDULED_SWEEP_INTERVAL_HOURS=24
