APP_NAME=RivalPulse
APP_ENV=development
DEBUG=true

# ============================================================
# AI / LLM
# ============================================================

LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini - optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Generic LLM configuration - optional
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=


# ============================================================
# Data Provider
# ============================================================

DATA_PROVIDER=yahoo

SECTORS_BASE_URL=
SECTORS_API_KEY=
SECTORS_TIMEOUT=10


# ============================================================
# Database / Redis
# ============================================================

DATABASE_URL=postgresql+psycopg://rivalpulse:rivalpulse@localhost:15432/rivalpulse
REDIS_URL=redis://localhost:6379/0


# ============================================================
# Workspace / Demo Authentication
# ============================================================

DEMO_ACCESS_TOKEN=replace-with-a-random-private-token-at-least-16-characters
WORKSPACE_ID=private-demo


# ============================================================
# Frontend CORS
# ============================================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]


# ============================================================
# Application Mode
# ============================================================

MODE=live
REPLAY_SCENARIO=baseline


# ============================================================
# Agent Limits
# ============================================================

CREDIT_TOTAL=1000
CREDIT_RESERVE=200
RUN_CREDIT_LIMIT=16

MAX_TOOL_CALLS=12
RUN_TIMEOUT=180
MAX_RUN_ATTEMPTS=3
PROVIDER_TIMEOUT=10


# ============================================================
# Cache
# ============================================================

CACHE_SECONDS=86400