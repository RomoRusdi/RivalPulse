# Repo-wide ignores. The frontend keeps its own .gitignore in frontend/,
# since git applies patterns relative to the file's own directory.

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — anywhere in the tree. Only redacted templates may be committed.
.env
.env.*
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
secrets.yaml
secrets.yml

# Python / backend (ready for whoever starts it)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.sqlite3

# Logs
*.log

# Local agent config — personal, and next dev regenerates AGENTS.md anyway.
AGENTS.md
CLAUDE.md


# Local verification artifacts
.test-work/
