# Shared ignores; frontend/backend also have package-specific rules.

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — anywhere in the tree. Only redacted templates may be committed.
.env
.env.*
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
secrets.yaml
secrets.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.sqlite3
*.db
*.egg-info/

# Logs
*.log

# Local coding-agent configuration
AGENTS.md
CLAUDE.md

# Generated contracts, build metadata, and local verification artifacts
/backend/docs/
/output/
*.tsbuildinfo
.test-work/
