# Repo-wide ignores. The frontend keeps its own .gitignore in frontend/,
# since git applies patterns relative to the file's own directory.

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — anywhere in the tree
.env
.env.*
!.env.example

# Python / backend (ready for whoever starts it)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.db
*.sqlite
*.sqlite3

# Local databases and exports
*.dump
*.backup

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local agent config — personal, and next dev regenerates AGENTS.md anyway.
AGENTS.md
CLAUDE.md

