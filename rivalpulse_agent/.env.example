# Production hackathon provider. Financial context comes from Sectors v2.
RIVALPULSE_DATA_PROVIDER=sectors
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v2
SECTORS_TIMEOUT_SECONDS=30
SECTORS_REPORT_CACHE_TTL_SECONDS=86400
SECTORS_NEWS_CACHE_TTL_SECONDS=3600

# Persistent comparison memory. Set empty only for stateless tests.
RIVALPULSE_MEMORY_FILE=.rivalpulse/research-memory.json

# Optional normalized JSON input for offline development.
RIVALPULSE_DATA_FILE=

# Local synthesis configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=900

# Optional normalized adapter from the data owner, as package.module:function.
RIVALPULSE_DATA_TOOLS_FACTORY=
